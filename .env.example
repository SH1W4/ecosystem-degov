# Network Configuration
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY_HERE
GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_KEY_HERE

# Private Key (NEVER share this!)
# Get from MetaMask: Settings > Security & Privacy > Show Private Key
# IMPORTANT: Use a TEST wallet, not your main wallet!
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Etherscan API Key (for contract verification)
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Deployed Contract Addresses (filled after deployment)
GST_TOKEN_ADDRESS=
AET_TOKEN_ADDRESS=
TRINITY_AI_ADDRESS=

# Optional: Alchemy (alternative to Infura)
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optional: Gas Configuration
# GAS_PRICE=2500000000
# GAS_LIMIT=3000000
